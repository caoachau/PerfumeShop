# Copy to .env and adjust if your API runs on a different host/port.

# Backend API (browser calls this directly if set; otherwise uses same-origin /api via Vite proxy)
VITE_API_URL=http://localhost:5000/api

# Cloudinary cloud name (Dashboard). Used to build image URLs in src/lib/cloudinaryAssets.ts
VITE_CLOUDINARY_CLOUD_NAME=dwj2trmn0
